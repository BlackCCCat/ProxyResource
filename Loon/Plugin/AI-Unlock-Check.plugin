#!name=AI 解锁检测 · 定时任务
#!desc=定时遍历指定策略组内的节点，检测 ChatGPT / Claude / Gemini 解锁情况，结果写入缓存供解析器打标；可选自动把 AI 策略组切换到延迟最低的可用节点。也可在「节点 / 策略组」页面手动触发查看单节点检测面板。
#!author=BlackCCCat[https://github.com/BlackCCCat]
#!homepage=https://github.com/BlackCCCat/ProxyResource
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/OpenAI.png
#!tag=AI,解锁检测,定时任务
#!system=iOS,iPadOS,macOS,tvOS
#!loon_version=3.5.0(969)
#!type=normal

[Argument]
cron = input,"11 */6 * * *",tag=定时表达式,desc=分 时 日 月 周。默认每 6 小时的第 11 分钟跑一次
group = input,"节点选择",tag=待检测的策略组,desc=必填。脚本会遍历这个策略组里的所有节点（建议填一个包含全部节点的组）
chatgpt = switch,true,tag=检测 ChatGPT
claude = switch,true,tag=检测 Claude
gemini = switch,true,tag=检测 Gemini,desc=单节点约 800KB 流量，蜂窝网络下建议改用 lite
depth = select,"full","lite",tag=检测深度,desc=full=请求各服务真实端点（准确、流量大）；lite=只按出口地区判断（几乎不耗流量）
strict = switch,false,tag=严格模式,desc=开启后 Cloudflare 人机验证、OpenAI App 机房 IP 拦截也算未解锁
routeCheck = switch,true,tag=路由自检,desc=抽样比对各节点的出口 IP。若全部相同说明请求没有真的分别走各节点，此时不写缓存也不自动切换。除非你的机场确实全部单出口，否则不要关
extraBlockCC = input,"",tag=追加地区黑名单,desc=逗号分隔的两位国家码，如 TW,VN。对三家服务同时生效
gptGroup = input,"",tag=自动切换 · ChatGPT 策略组,desc=留空则不自动切换。填策略组名，会切到延迟最低的可解锁节点
cldGroup = input,"",tag=自动切换 · Claude 策略组,desc=留空则不自动切换
gmnGroup = input,"",tag=自动切换 · Gemini 策略组,desc=留空则不自动切换
marker = input,"⚡",tag=标记前缀,desc=需与解析器插件保持一致，用于正确剥离节点名上的标记
concurrency = input,"5",tag=并发数,desc=1-16
timeout = input,"6000",tag=单次请求超时,desc=毫秒
budget = input,"240",tag=检测总预算,desc=秒。须小于下面脚本的 timeout
cacheTTL = input,"12",tag=缓存有效期,desc=小时
notify = switch,true,tag=完成后通知

[Script]
cron {cron} script-path=https://raw.githubusercontent.com/BlackCCCat/ProxyResource/main/Loon/Script/ai_unlock.js,tag=AI解锁检测,timeout=300,enable=true,argument=[{group},{chatgpt},{claude},{gemini},{depth},{strict},{routeCheck},{extraBlockCC},{gptGroup},{cldGroup},{gmnGroup},{marker},{concurrency},{timeout},{budget},{cacheTTL},{notify}]

generic script-path=https://raw.githubusercontent.com/BlackCCCat/ProxyResource/main/Loon/Script/ai_unlock.js,tag=AI解锁检测,timeout=300,img-url=sparkles.system,argument=[{group},{chatgpt},{claude},{gemini},{depth},{strict},{routeCheck},{extraBlockCC},{gptGroup},{cldGroup},{gmnGroup},{marker},{concurrency},{timeout},{budget},{cacheTTL},{notify}]
